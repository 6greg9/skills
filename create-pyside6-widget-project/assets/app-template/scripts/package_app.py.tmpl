#!/usr/bin/env python3
"""Build, audit, and smoke-test the generated desktop executable."""

from __future__ import annotations

import argparse
import os
import subprocess
import sys
import tomllib
from pathlib import Path

from audit_package import audit_package, print_report


APP_ROOT = Path(__file__).resolve().parents[1]


def project_name() -> str:
    with (APP_ROOT / "pyproject.toml").open("rb") as stream:
        return str(tomllib.load(stream)["project"]["name"])


def executable_path(name: str) -> Path:
    suffix = ".exe" if sys.platform == "win32" else ""
    return APP_ROOT / "dist" / name / f"{name}{suffix}"


def build(profile: str, name: str) -> Path:
    environment = os.environ.copy()
    environment["PYSIDE6_PACKAGE_PROFILE"] = profile
    spec = APP_ROOT / "packaging" / f"{name}.spec"
    subprocess.run(
        [
            sys.executable,
            "-m",
            "PyInstaller",
            "--noconfirm",
            "--clean",
            str(spec),
        ],
        cwd=APP_ROOT,
        env=environment,
        check=True,
    )
    return APP_ROOT / "dist" / name


def smoke_test(executable: Path, timeout_seconds: float) -> None:
    if not executable.is_file():
        raise FileNotFoundError(f"packaged executable does not exist: {executable}")
    environment = os.environ.copy()
    environment["PYSIDE6_SMOKE_TEST"] = "1"
    creation_flags = subprocess.CREATE_NO_WINDOW if sys.platform == "win32" else 0
    result = subprocess.run(
        [str(executable)],
        cwd=executable.parent,
        env=environment,
        capture_output=True,
        text=True,
        timeout=timeout_seconds,
        creationflags=creation_flags,
        check=False,
    )
    if result.returncode != 0:
        details = (result.stdout + result.stderr).strip()
        raise RuntimeError(
            f"packaged smoke test exited with code {result.returncode}: {details}"
        )


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--profile", choices=("minimal", "full"), default="minimal")
    parser.add_argument("--no-smoke", action="store_true")
    parser.add_argument("--smoke-timeout", type=float, default=15.0)
    parser.add_argument("--max-size-mib", type=float)
    args = parser.parse_args()

    name = project_name()
    try:
        runtime_root = build(args.profile, name)
        report = audit_package(runtime_root, args.profile)
        print_report(report, args.profile)
        if report.violations:
            raise RuntimeError("package audit found minimal-profile violations")
        if (
            args.max_size_mib is not None
            and report.total_bytes > args.max_size_mib * 1024 * 1024
        ):
            raise RuntimeError(
                f"package exceeds {args.max_size_mib:.2f} MiB size limit"
            )
        if not args.no_smoke:
            smoke_test(executable_path(name), args.smoke_timeout)
            print("Packaged smoke test passed.")
    except (FileNotFoundError, OSError, RuntimeError, subprocess.SubprocessError) as exc:
        print(f"error: {exc}")
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
