[project]
name = "__PROJECT_NAME__"
version = "0.1.0"
description = "PySide6 Widgets desktop application"
readme = "README.md"
requires-python = ">=3.13"
dependencies = [
    "pyside6>=6.11.1",
]

[project.scripts]
__PROJECT_NAME__ = "__PACKAGE_NAME__:main"

[dependency-groups]
dev = [
    "pyinstaller",
    "pytest",
    "pytest-qt",
]

[build-system]
requires = ["uv_build>=0.11.28,<0.12.0"]
build-backend = "uv_build"

[tool.pytest.ini_options]
addopts = "-q"
testpaths = ["tests"]
